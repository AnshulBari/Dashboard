[TEMPLATE]
# Backend
DATABASE_URL=postgresql://user:password@localhost:5432/cricket_intelligence
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (prefix with VITE_ for client-side access)
VITE_API_URL=http://localhost:8000/api

# External Cricket Data Providers
# CricketData.org (formerly CricAPI) - Free tier: 100 hits/day
# Sign up at: https://cricketdata.org
CRICKETDATA_API_KEY=

# Note: the CricketData.org key is only used for live match data.
# Official ICC rankings use the public feed behind icc-cricket.com and retain
# a bundled verified snapshot if that feed is temporarily unavailable.
# Historical analytics continue working without external providers.
