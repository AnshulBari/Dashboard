{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": ".",
      "entrypoint": "backend.main:app",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/live",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/matches",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/matches/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/players",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/players/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/teams",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/teams/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/venues",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/venues/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/matchups",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/rankings",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/competitions",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/competitions/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
